{
  "manifest_version": 3,
  "name": "VietTubeLens",
  "version": "0.2.1",
  "description": "Phân tích phản ứng cộng đồng trên YouTube bằng bằng chứng và độ tin cậy.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VietTubeLens"
  },
  "background": { "service_worker": "service-worker.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
